# ---------------------------------------------------------------------------
# well-cinebox — environment
# Everything here is OPTIONAL; the app boots with sane defaults.
# ---------------------------------------------------------------------------

# Public URL of the deployment (used for canonical links, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=https://well-cinebox.vercel.app

# Secret used to HMAC-sign /api/stream + /api/subtitle tokens.
# Generate with: openssl rand -hex 32     (REQUIRED in production)
STREAM_SIGNING_SECRET=

# How long a signed stream token stays valid (seconds).
STREAM_TOKEN_TTL_SEC=21600

# ---------------------------------------------------------------------------
# PROVIDER EGRESS  ***the one that decides whether you get a live catalog***
#
# The MovieBox BFF blocks datacenter IPs. Measured from production:
#   Vercel iad1, unsigned  -> 403 "Service not available in current region"
#   Vercel bom1, any       -> 440 {"message":"ServiceNotAvailable"}
# Headers/signature/XFF spoofing change nothing; it keys off the TCP source IP.
#
# Point this at an HTTP(S) proxy whose exit IP is residential or mobile in a
# served region (South/Southeast Asia, Africa). All provider calls, media and
# subtitle traffic are routed through it. Leave empty to run on the bundled
# offline demo catalog. Verify with /api/debug/provider.
#
# MOVIEBOX_PROXY_URL=http://user:pass@residential-proxy.example.com:8080
MOVIEBOX_PROXY_URL=

# MovieBox homepage tab to render on "/" (upstream TUI browses tab 2).
MOVIEBOX_HOME_TAB=2

# Per-request timeout against the MovieBox host pool (ms).
MOVIEBOX_TIMEOUT_MS=12000

# In-process catalog cache TTL (ms).
CONTENT_CACHE_TTL_MS=300000
