# ---------------------------------------------------------------------------
# well-cinebox — environment
# Everything here is OPTIONAL; the app boots with sane defaults.
# ---------------------------------------------------------------------------

# Public URL of the deployment (used for canonical links, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=https://well-cinebox.vercel.app

# Secret used to HMAC-sign /api/stream + /api/subtitle tokens.
# Generate with: openssl rand -hex 32     (REQUIRED in production)
STREAM_SIGNING_SECRET=

# How long a signed stream token stays valid (seconds).
STREAM_TOKEN_TTL_SEC=21600

# MovieBox homepage tab to render on "/" (upstream TUI browses tab 2).
MOVIEBOX_HOME_TAB=2

# Per-request timeout against the MovieBox host pool (ms).
MOVIEBOX_TIMEOUT_MS=12000

# In-process catalog cache TTL (ms).
CONTENT_CACHE_TTL_MS=300000
